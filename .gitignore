# Claude Code
.claude/

# Godot binaries (download separately)
*.exe
godot.bat

# Tracked test gate outputs and local CI tool downloads
.test-gate/
.ci/
to-rust-as-we-fall/node_modules/
to-rust-as-we-fall/test-results/

# godot-cpp (large dependency — clone/copy separately)
godot-cpp/

# Godot editor cache
to-rust-as-we-fall/.godot/

# Built native libraries and linker artifacts
to-rust-as-we-fall/bin/*.dll
to-rust-as-we-fall/bin/*.so
to-rust-as-we-fall/bin/*.wasm
to-rust-as-we-fall/bin/*.dylib
to-rust-as-we-fall/bin/*.framework/
to-rust-as-we-fall/bin/*.lib
to-rust-as-we-fall/bin/*.exp
to-rust-as-we-fall/bin/~*.TMP

# SCons build artifacts
native/.sconsign.dblite
native/**/*.obj
native/**/*.o
native/**/*.lib
native/**/*.a

# Android export
to-rust-as-we-fall/android/

# Generated hide-encounter analysis artifacts
to-rust-as-we-fall/hide_encounter*_analysis.json
to-rust-as-we-fall/hide_encounter_*.png
to-rust-as-we-fall/*_analysis_plots/
to-rust-as-we-fall/dialogue_dump.txt

# Debug/capture screenshots + their Godot import sidecars, and one-off scratch, written to the
# PROJECT ROOT by capture/diagnostic tools. Throwaway — capture to the scratchpad dir, never the
# project. Enforced by --test-project-hygiene so pollution goes RED, not silently committed.
to-rust-as-we-fall/*.png
to-rust-as-we-fall/*.png.import
to-rust-as-we-fall/*_decomposition.json
to-rust-as-we-fall/diag_*.gd
to-rust-as-we-fall/diag_*.gd.uid

# Art SOURCE is version-controlled (director 2026-08-12: the whole project commits;
# .blend/.fbx ride Git LFS — see .gitattributes). What stays OUT is regenerable OUTPUT:
# Blender's auto-backups, render-frame dumps, and animation preview clips, all of which
# rebuild from the committed .blend masters.
*.blend1
blender/**/*frames*/
blender/elevator/hallway_*/
blender/elevator/cam*.png
blender/**/*.gif
blender/**/*.mp4

# Generated reports + run artifacts
to-rust-as-we-fall/reports/
to-rust-as-we-fall/.qa-logs/
to-rust-as-we-fall/.qa-videos/

# Temp logs and editor lock files
*.err.log
*.out.log
tmp_*.log
~$*.xlsx

# Stray temp files
*.tmp

# Visual-capture eyeball outputs (tools/capture_overlays.gd)
/aster_*.png
/peris_*.png

# Android export output
to-rust-as-we-fall/build/

# Codex session scratch (godot logs, shader caches, per-run user dirs) — never source
.codex-tmp/
.codex-remote-attachments/
to-rust-as-we-fall/Godot/

# Node harness deps (the playwright web-smoke rig; package.json IS tracked)
node_modules/

# Browser-play driver scratch. Must live INSIDE to-rust-as-we-fall/ so node resolves
# @playwright/test from its node_modules; the scratchpad dir cannot. Recipe: docs/TESTING.md.
to-rust-as-we-fall/.playtmp/

# Session scratch at the game root (same class as the png pollution patterns above)
to-rust-as-we-fall/tmp/
to-rust-as-we-fall/*.jpg
