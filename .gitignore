# Claude Code
.claude/

# Godot binaries (download separately)
*.exe
godot.bat

# godot-cpp (large dependency — clone/copy separately)
godot-cpp/

# Godot editor cache
to-rust-as-we-fall/.godot/

# Built native libraries and linker artifacts
to-rust-as-we-fall/bin/*.dll
to-rust-as-we-fall/bin/*.so
to-rust-as-we-fall/bin/*.dylib
to-rust-as-we-fall/bin/*.framework/
to-rust-as-we-fall/bin/*.lib
to-rust-as-we-fall/bin/*.exp
to-rust-as-we-fall/bin/~*.TMP

# SCons build artifacts
native/.sconsign.dblite
native/**/*.obj
native/**/*.o
native/**/*.lib
native/**/*.a

# Android export
to-rust-as-we-fall/android/

# Generated hide-encounter analysis artifacts
to-rust-as-we-fall/hide_encounter*_analysis.json
to-rust-as-we-fall/hide_encounter_*.png
to-rust-as-we-fall/*_analysis_plots/
to-rust-as-we-fall/dialogue_dump.txt

# Debug/capture screenshots + their Godot import sidecars, and one-off scratch, written to the
# PROJECT ROOT by capture/diagnostic tools. Throwaway — capture to the scratchpad dir, never the
# project. Enforced by --test-project-hygiene so pollution goes RED, not silently committed.
to-rust-as-we-fall/*.png
to-rust-as-we-fall/*.png.import
to-rust-as-we-fall/*_decomposition.json
to-rust-as-we-fall/diag_*.gd
to-rust-as-we-fall/diag_*.gd.uid

# Art-tool working directories (source lives here; game-ready exports go in
# to-rust-as-we-fall/resources/). Too large / scratch for version control.
asesprite/
blender/
blockbench/
crocotile/
kitbash-tool/

# Design research / reference images (not used by the game at runtime).
# Kept on disk outside the game folder, out of version control.
reference-images/

# Canonical design docs (GDD, taxonomies) copied in for reference — consult before adding/naming
# game content (see .claude/CLAUDE.md). Large/source; mirror of the Downloads originals, untracked.
reference-docs/

# Generated reports + run artifacts
to-rust-as-we-fall/reports/

# Temp logs and editor lock files
*.err.log
*.out.log
tmp_*.log
~$*.xlsx

# Stray temp files
*.tmp

# Visual-capture eyeball outputs (tools/capture_overlays.gd)
/aster_*.png
/peris_*.png

# Android export output
to-rust-as-we-fall/build/
