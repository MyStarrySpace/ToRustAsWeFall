[configuration]
entry_symbol = "trwf_library_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://bin/libtrwf.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libtrwf.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libtrwf.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libtrwf.linux.template_release.x86_64.so"
