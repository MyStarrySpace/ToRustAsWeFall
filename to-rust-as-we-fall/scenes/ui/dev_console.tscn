[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/system/dev_console.gd" id="1_console"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_console"]
bg_color = Color(0.05, 0.07, 0.08, 0.92)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.36, 0.91, 0.5, 0.5)

[node name="DevConsole" type="CanvasLayer"]
layer = 90
visible = false
process_mode = 3
script = ExtResource("1_console")

[node name="ConsolePanel" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(0, 220)
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 220.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_console")

[node name="Content" type="VBoxContainer" parent="ConsolePanel"]
layout_mode = 2

[node name="Log" type="RichTextLabel" parent="ConsolePanel/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 13
scroll_following = true

[node name="Input" type="LineEdit" parent="ConsolePanel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
placeholder_text = "Esc closes // help lists commands"

[connection signal="gui_input" from="ConsolePanel/Content/Input" to="." method="_on_input_gui_input"]
[connection signal="text_submitted" from="ConsolePanel/Content/Input" to="." method="_on_submitted"]
