# Godot 4+ specific ignores
.godot/
/android/

# Godot binaries (kept at project root, outside this dir)
*.exe

# Godot auto-generated translation resources from CSV imports
*.translation

# Dev highlight capture (tools/capture_highlight.gd)
/highlight_capture.png
/highlight_capture.png.import
/path_capture.png
/path_capture.png.import

# Visual regression captures (--test-visual-regression, windowed)
/vr_*.png
/vr_*.png.import

# Dev spiral capture (tools/capture_spiral.gd, windowed)
/spiral_capture_*.png
/spiral_capture_*.png.import

# Dev Watched Gap capture (tools/capture_watched_gap.gd, windowed)
/watched_gap_capture.png
/watched_gap_capture.png.import

# Dev outline capture (tools/capture_aster_outline.gd, tools/capture_chunk_outline.gd)
/aster_outline_cap.png
/aster_outline_cap.png.import
/outline_cap_*.png
/chunk_outline_*.png
/chunk_outline_*.png.import
/glow_*.png
/glow_*.png.import

# Dev Pump Hall capture (tools/capture_pump_hall.gd, windowed)
/pump_hall_capture.png
/pump_hall_capture.png.import
