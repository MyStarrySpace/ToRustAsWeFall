[resource]
script = ExtResource("1_blfl")
id = "blind_floor"
title = "The Blind Floor"
help = "The keeper owns the lane — there is no gap in that walk, and every open tile is in its eye. The pale floor along the south wall is blind ground: the film swallows every scan, and it eats you the whole way across. Pay in health at a walk, or pay stamina to shorten the toll. If someone drops in the film, someone else wades in."
default_character = "peris"
