[resource]
script = ExtResource("1_bfp")
id = "basin_fill_proof"
title = "Balancing Basin — Fill Proof"
help = "Start on the west CURRENT RETURN shelf. Get everyone to the south balcony shelter. Climb either north DECK ACCESS ladder before the basin rises. LOW opens the bowl floor; MID raises the center float road; HIGH leaves only the decks. A missed rise sweeps you back to the shelf you started on. A stranded LOW bowl member can climb the marked south recovery ladder back to the balcony."
default_character = "aster"
party_ids = PackedStringArray("aster", "peris", "endo")
spawns = {
"aster": Vector3(-0.75, 0, 2.25),
"endo": Vector3(-0.75, 0, 5.25),
"peris": Vector3(-0.75, 0, 3.75)
}
