[resource]
script = ExtResource("1_spgap")
id = "sprint_gap"
title = "Sprint Gap"
help = "One watcher, one scarpet, one bar of stamina. The bar buys forty units of sprint and the gap costs most of it — launch when the watch sweeps away, hold your breath on the scarpet through the pass, and spend the rest in one clean burst. Walk it or waste it and the watch has you."
default_character = "peris"
