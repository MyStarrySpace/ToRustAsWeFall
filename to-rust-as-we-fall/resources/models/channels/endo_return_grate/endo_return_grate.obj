# Endo Junction return grate. Metres, Y-up, pivot at bottom-centre.
# Portable two-sided lattice source; collision and lift authority live in the Godot wrapper.
mtllib endo_return_grate.mtl
o endo_return_grate

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# left frame
v -2.250 0.000 0.000
v -2.050 0.000 0.000
v -2.050 2.350 0.000
v -2.250 2.350 0.000
# inner bar 1
v -1.380 0.000 0.000
v -1.220 0.000 0.000
v -1.220 2.350 0.000
v -1.380 2.350 0.000
# inner bar 2
v -0.510 0.000 0.000
v -0.350 0.000 0.000
v -0.350 2.350 0.000
v -0.510 2.350 0.000
# inner bar 3
v 0.350 0.000 0.000
v 0.510 0.000 0.000
v 0.510 2.350 0.000
v 0.350 2.350 0.000
# inner bar 4
v 1.220 0.000 0.000
v 1.380 0.000 0.000
v 1.380 2.350 0.000
v 1.220 2.350 0.000
# right frame
v 2.050 0.000 0.000
v 2.250 0.000 0.000
v 2.250 2.350 0.000
v 2.050 2.350 0.000
# bottom beam
v -2.250 0.000 0.006
v 2.250 0.000 0.006
v 2.250 0.200 0.006
v -2.250 0.200 0.006
# top beam
v -2.250 2.150 0.006
v 2.250 2.150 0.006
v 2.250 2.350 0.006
v -2.250 2.350 0.006

usemtl endo_return_grate
s off
f 1/1 2/2 3/3 4/4
f 4/4 3/3 2/2 1/1
f 5/1 6/2 7/3 8/4
f 8/4 7/3 6/2 5/1
f 9/1 10/2 11/3 12/4
f 12/4 11/3 10/2 9/1
f 13/1 14/2 15/3 16/4
f 16/4 15/3 14/2 13/1
f 17/1 18/2 19/3 20/4
f 20/4 19/3 18/2 17/1
f 21/1 22/2 23/3 24/4
f 24/4 23/3 22/2 21/1
f 25/1 26/2 27/3 28/4
f 28/4 27/3 26/2 25/1
f 29/1 30/2 31/3 32/4
f 32/4 31/3 30/2 29/1
